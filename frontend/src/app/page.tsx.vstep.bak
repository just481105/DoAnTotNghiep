                    <h2 className="text-lg font-extrabold text-slate-800 dark:text-slate-100">Lỗi hay gặp</h2>
                    <span className="flex items-center gap-1 rounded-full border border-sky-100 bg-sky-50 px-2.5 py-0.5 text-[11px] font-bold text-sky-700">
