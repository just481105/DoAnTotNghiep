              </div>
              <span className="flex items-center gap-1 rounded-full border border-orange-100 bg-orange-50 px-3 py-1 text-[11px] font-extrabold tracking-wide text-orange-600">
                <Flame className="size-3.5" /> COMPETITION
              </span>
            </div>

            <div className="mt-5 flex items-center justify-between px-2 text-[11px] font-bold tracking-wider text-slate-400">
              <span>#&nbsp;&nbsp;&nbsp;&nbsp;HỌC VIÊN</span>
              <span>LẦN NỘP BÀI</span>
            </div>

            <div className="mt-2 space-y-2.5">
              {LEADERBOARD.map((u, i) => (
                <div
