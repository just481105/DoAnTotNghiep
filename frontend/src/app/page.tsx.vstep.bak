          </section>
        </div>

        {/* ============ PHÒNG THI THỬ ============ */}
        <section className="space-y-4 pt-2">
          <div className="flex flex-wrap items-center justify-between gap-2">
            <div className="flex flex-wrap items-center gap-3">
              <span className="size-2.5 rounded-full bg-orange-400" />
              <h2 className="text-lg font-extrabold text-slate-900 dark:text-slate-100">Phòng Thi Thử VSTEP (Mock Test)</h2>
              <span className="rounded-full border border-amber-200 bg-amber-50 px-3 py-1 text-xs font-bold text-amber-700">
                Chuẩn format thi thật
              </span>
            </div>
            <p className="text-sm text-slate-500">
              Làm bài thi thử <b className="text-slate-800 dark:text-slate-100">4 kỹ năng</b> hoặc kiểm tra{" "}
              <b className="text-slate-800 dark:text-slate-100">nguyên 1 kỹ năng</b> có bấm giờ
            </p>
          </div>

          <div className="grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-5">
            {MOCK_TESTS.map((t) => (
              <Link
                key={t.title}
                href={t.href}
                className="group rounded-[28px] border border-amber-100 bg-amber-50/40 p-3 transition hover:-translate-y-0.5 hover:shadow-md dark:border-slate-800 dark:bg-slate-900/70"
              >
                <div className={`relative grid h-40 place-items-center rounded-3xl border border-white bg-linear-to-br ${t.tone}`}>
                  <span
                    className={`absolute left-3 top-3 rounded-full px-2.5 py-1 text-[11px] font-bold ${
                      t.title === "Full Test"
                        ? "bg-blue-700 text-white"
                        : "border border-slate-200 bg-white text-slate-600"
                    }`}
                  >
                    {t.tag}
                  </span>
                  <span
                    className={`absolute right-3 top-3 rounded-full border px-2.5 py-1 text-[11px] font-bold ${
                      t.free
                        ? "border-emerald-200 bg-emerald-50 text-emerald-600"
                        : "border-amber-200 bg-amber-50 text-amber-700"
                    }`}
                  >
                    {t.free ? "Free" : "👑 Pro"}
                  </span>
                  <span className="text-6xl transition-transform group-hover:scale-110">{t.emoji}</span>
                </div>
                <div className="px-1 pb-1 pt-3 text-center">
                  <h3 className="text-base font-extrabold text-slate-900 dark:text-slate-100">{t.title}</h3>
                  <p className="text-xs text-slate-500">{t.meta}</p>
                </div>
              </Link>
            ))}
          </div>
        </section>

        {/* ============ THANH LỌC ============ */}
        <section className={`${CARD} flex flex-col items-stretch gap-3 p-3 lg:flex-row lg:items-center`}>
          {/* trạng thái */}
          <div className="flex items-center gap-1 rounded-2xl bg-sky-50/70 p-1.5 dark:bg-slate-800/60">
            {STATUS_TABS.map((t) => (
              <button
                key={t}
                onClick={() => {
                  setStatusTab(t);
                  resetPage();
                }}
                className={`rounded-xl px-5 py-2 text-sm font-bold transition ${
                  statusTab === t
                    ? "bg-white text-slate-900 shadow-sm dark:bg-slate-700 dark:text-white"
                    : "text-slate-500 hover:text-slate-800"
                }`}
              >
                {t}
              </button>
            ))}
          </div>

          {/* loại đề */}
          <div className="flex items-center gap-1 overflow-x-auto rounded-2xl bg-sky-50/70 p-1.5 dark:bg-slate-800/60">
            {TYPE_TABS.map((t) => (
              <button
                key={t.label}
                onClick={() => {
                  setTypeTab(t.label);
                  resetPage();
                }}
                className={`flex items-center gap-1.5 whitespace-nowrap rounded-xl px-4 py-2 text-sm font-bold transition ${
                  typeTab === t.label
                    ? "bg-white text-slate-900 shadow-sm dark:bg-slate-700 dark:text-white"
                    : "text-slate-500 hover:text-slate-800"
                }`}
              >
                {t.label}
                {t.pro && (
                  <span className="rounded-md bg-blue-600 px-1.5 py-0.5 text-[10px] font-extrabold text-white">PRO</span>
                )}
              </button>
            ))}
          </div>

          <div className="flex items-center gap-2 whitespace-nowrap rounded-2xl border border-sky-100 bg-sky-50/60 px-4 py-2.5 text-sm text-slate-600">
            <Sparkles className="size-4 text-amber-500" />
            <b className="text-blue-700">{filtered.length}</b> bài tập
          </div>

          <div className="relative min-w-0 flex-1">
            <Search className="absolute left-4 top-1/2 size-4 -translate-y-1/2 text-slate-400" />
            <input
              value={query}
              onChange={(e) => {
                setQuery(e.target.value);
                resetPage();
              }}
              placeholder="Tìm kiếm bài tập, đề thi..."
              className="w-full rounded-2xl border border-slate-200 bg-white py-2.5 pl-10 pr-4 text-sm outline-none transition placeholder:text-slate-400 focus:border-blue-300 focus:ring-4 focus:ring-blue-100 dark:border-slate-700 dark:bg-slate-900"
            />
          </div>
        </section>

        {/* ============ KHO ĐỀ ============ */}
        <section className="grid grid-cols-1 gap-6 lg:grid-cols-[260px_minmax(0,1fr)]">
          {/* sidebar kỹ năng */}
          <aside className={`${CARD} h-fit p-4`}>
            <p className="px-2 pb-3 text-xs font-bold tracking-widest text-slate-400">KỸ NĂNG</p>
            <div className="space-y-1">
              <button
                onClick={() => {
                  setSkill("all");
                  resetPage();
                }}
                className={`flex w-full items-center gap-3 rounded-2xl px-4 py-3 text-left text-base font-bold transition ${
                  skill === "all" ? "bg-blue-600 text-white shadow-md shadow-blue-600/25" : "text-slate-600 hover:bg-slate-50"
                }`}
              >
                <Globe className="size-5" />
                <span className="flex-1">Tất cả</span>
                <span
                  className={`rounded-full px-2.5 py-0.5 text-xs font-bold ${
                    skill === "all" ? "bg-white/25 text-white" : "bg-slate-100 text-slate-500"
                  }`}
                >
                  {EXAMS.length} bài
                </span>
              </button>

              {(Object.keys(SKILL_META) as Skill[]).map((s) => {
                const Icon = SKILL_META[s].icon;
                const active = skill === s;
                return (
                  <button
                    key={s}
                    onClick={() => {
                      setSkill(s);
                      resetPage();
                    }}
                    className={`flex w-full items-center gap-3 rounded-2xl px-4 py-3 text-left text-base font-semibold transition ${
                      active ? "bg-blue-600 text-white shadow-md shadow-blue-600/25" : "text-slate-600 hover:bg-slate-50"
                    }`}
                  >
                    <Icon className="size-5" />
                    <span className="flex-1">{SKILL_META[s].label}</span>
                    <span className={`text-xs ${active ? "text-white/80" : "text-slate-400"}`}>{skillCount(s)}</span>
                  </button>
                );
              })}
            </div>
          </aside>

          {/* danh sách đề */}
          <div>
            <div className="mb-3 flex items-center justify-between text-sm">
              <p className="flex items-center gap-2 text-slate-500">
                <span className="size-2 rounded-full bg-emerald-500" />
                Kho đề: <b className="text-slate-800 dark:text-slate-100">{filtered.length} bài tập</b> sẵn có
              </p>
              <span className="text-slate-400">
                Trang {currentPage}/{totalPages}
              </span>
            </div>

            {pageItems.length === 0 ? (
              <div className={`${CARD} p-10 text-center text-sm text-slate-500`}>Không tìm thấy bài tập phù hợp.</div>
            ) : (
              <div className="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">
                {pageItems.map((e) => (
                  <Link
                    key={e.id}
                    href={`/exams/${e.id}`}
                    className={`${CARD} group flex flex-col p-3 transition hover:-translate-y-0.5 hover:shadow-md`}
                  >
                    <div className={`relative grid h-40 place-items-center rounded-2xl bg-linear-to-br ${e.tone}`}>
                      {e.done && (
                        <span className="absolute left-2 top-2 flex items-center gap-1 rounded-full bg-emerald-500 px-2.5 py-1 text-[11px] font-extrabold text-white">
                          <CheckCircle2 className="size-3.5" /> ĐÃ LÀM
                        </span>
                      )}
                      <span className="text-6xl transition-transform group-hover:scale-110">{e.emoji}</span>
                      <span className="absolute bottom-2 right-2 rounded-lg bg-white px-2.5 py-1 text-[11px] font-extrabold text-rose-700 shadow-sm">
                        {e.part}
                      </span>
                    </div>

                    <h3 className="mt-3 line-clamp-3 min-h-[4.5rem] px-1 text-base font-extrabold leading-snug text-slate-900 dark:text-slate-100">
                      {e.title}
                    </h3>

                    {e.done && e.attempts ? (
                      <span className="mb-2 ml-1 flex w-fit items-center gap-1.5 rounded-full border border-emerald-200 bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-700">
                        <History className="size-3.5" /> Xem lịch sử ({e.attempts})
                      </span>
                    ) : (
                      <span className="mb-2 h-6" />
                    )}

                    <div className="mt-auto flex items-center justify-between border-t border-slate-100 px-1 pt-3 dark:border-slate-800">
                      <span
                        className={`rounded-full px-3 py-1 text-xs font-bold ${
                          e.questions > 1 ? "bg-rose-50 text-rose-600" : "bg-amber-50 text-amber-700"
                        }`}
                      >
                        {e.questions} câu hỏi
                      </span>
                      <span className="text-xs font-bold text-rose-600">
                        {e.part.charAt(0) + e.part.slice(1).toLowerCase()}
                      </span>
                    </div>
                  </Link>
                ))}
              </div>
            )}

            {/* phân trang */}
            {totalPages > 1 && (
              <div className="mt-5 flex items-center justify-center gap-2">
                <button
                  disabled={currentPage === 1}
                  onClick={() => setPage(currentPage - 1)}
                  className="grid size-9 place-items-center rounded-xl border border-slate-200 bg-white text-slate-600 transition hover:bg-slate-50 disabled:opacity-40"
                >
                  <ChevronLeft className="size-4" />
                </button>
                {Array.from({ length: totalPages }).map((_, i) => (
                  <button
                    key={i}
                    onClick={() => setPage(i + 1)}
                    className={`size-9 rounded-xl text-sm font-bold transition ${
                      currentPage === i + 1
                        ? "bg-blue-600 text-white shadow-md shadow-blue-600/25"
                        : "border border-slate-200 bg-white text-slate-600 hover:bg-slate-50"
                    }`}
                  >
                    {i + 1}
                  </button>
                ))}
                <button
                  disabled={currentPage === totalPages}
                  onClick={() => setPage(currentPage + 1)}
                  className="grid size-9 place-items-center rounded-xl border border-slate-200 bg-white text-slate-600 transition hover:bg-slate-50 disabled:opacity-40"
                >
                  <ChevronRight className="size-4" />
                </button>
              </div>
            )}
          </div>
        </section>
      </main>
    </div>
  );
}
