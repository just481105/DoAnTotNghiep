                  className="flex items-center gap-3 rounded-2xl border border-amber-100 bg-amber-50/50 px-3 py-2.5 dark:border-amber-900/40 dark:bg-amber-950/10"
                >
                  <span className="grid w-7 place-items-center text-amber-500">
                    {i === 0 ? <Crown className="size-5" /> : <Medal className="size-5" />}
                  </span>
                  <span className={`grid size-9 shrink-0 place-items-center rounded-full text-sm font-bold text-white ${u.color}`}>
                    {u.avatar}
                  </span>
                  <span className="min-w-0 flex-1 truncate text-sm font-semibold text-slate-800 dark:text-slate-100">
                    {u.name}
                  </span>
                  <span className="text-right">
                    <b className="text-base text-orange-700">{u.count}</b>{" "}
                    <span className="text-xs text-slate-400">bài</span>
                  </span>
                </div>
              ))}
            </div>
          </section>
        </div>

        {/* ============ HÀNG 2: TOP CHỦ ĐỀ | LỖI HAY GẶP ============ */}
        <div className="grid grid-cols-1 gap-6 lg:grid-cols-[minmax(0,1.35fr)_minmax(0,1fr)]">
          {/* TOP 3 CHỦ ĐỀ */}
          <section className={`${CARD} bg-linear-to-br from-amber-50/60 via-white to-white p-6`}>
            <div className="flex items-start justify-between gap-3">
              <div className="flex items-center gap-3">
                <IconTile className="bg-amber-50 text-amber-500">
                  <Trophy className="size-6" />
                </IconTile>
                <div>
                  <div className="flex flex-wrap items-center gap-2">
                    <h2 className="text-lg font-extrabold text-slate-800 dark:text-slate-100">Top 3 chủ đề VSTEP</h2>
                    <span className="rounded-full border border-amber-200 bg-amber-50 px-2.5 py-0.5 text-[11px] font-bold text-amber-700">
                      ✨ Tháng 09/2026
                    </span>
                  </div>
                  <p className="text-sm text-slate-500">Từ 2.262 đề thi thật gần nhất</p>
                </div>
              </div>
              <Link
