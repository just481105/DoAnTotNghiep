                  <span className="flex items-center gap-1.5">
                    <span className="size-2 rounded-full bg-blue-500" /> Writing: <b>{TOP_TOPICS.main.writing}</b>
                  </span>
                </div>
                <span className="rounded-full border border-amber-200 bg-amber-50 px-3 py-1 text-xs font-semibold text-amber-700">
                  Xuất hiện nhiều nhất
                </span>
              </div>
            </div>

            <div className="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
              {TOP_TOPICS.others.map((t) => {
                const Icon = t.icon;
                return (
                  <div key={t.rank} className="rounded-3xl border border-slate-200/70 bg-white p-4">
                    <div className="flex items-center justify-between">
                      <span className="rounded-md bg-blue-50 px-2 py-0.5 text-xs font-bold text-blue-600">#{t.rank}</span>
                      <span className="text-sm font-bold text-slate-700">{t.percent}</span>
                    </div>
                    <div className="mt-3 flex items-center gap-2.5">
                      <IconTile className={`size-9 rounded-xl ${t.color}`}>
                        <Icon className="size-4" />
                      </IconTile>
                      <h3 className="text-base font-extrabold text-slate-900">{t.title}</h3>
                    </div>
                    <p className="mt-2 text-sm text-slate-400">{t.exams} đề thi thật</p>
                  </div>
                );
              })}
            </div>
          </section>

          {/* LỖI HAY GẶP */}
          <section className={`${CARD} flex flex-col p-6`}>
            <div className="flex items-start justify-between gap-3">
              <div className="flex items-center gap-3">
                <IconTile className="bg-sky-50 text-sky-500">
                  <Target className="size-6" />
                </IconTile>
                <div>
