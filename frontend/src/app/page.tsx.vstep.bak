                </IconTile>
                <div>
                  <h2 className="text-lg font-extrabold text-slate-800 dark:text-slate-100">Hành trình chăm chỉ</h2>
                  <p className="text-sm text-slate-500">Ghi nhận tiến độ nộp bài mỗi ngày</p>
                </div>
              </div>
              <div className="flex items-center gap-1.5 rounded-full border border-slate-200/70 bg-slate-50 px-3 py-1.5 text-[11px] text-slate-500 dark:border-slate-800 dark:bg-slate-800/50">
                Ít
                {HEAT_COLORS.map((c, i) => (
                  <span key={i} className={`size-3 rounded-full ${c}`} />
                ))}
                Nhiều
              </div>
            </div>

            <div className="mt-6 overflow-x-auto pb-1">
              <div className="flex min-w-max gap-3">
