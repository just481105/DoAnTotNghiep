];

const STATUS_TABS = ["Tất cả", "Chưa làm", "Đã làm"] as const;
const TYPE_TABS: { label: string; pro?: boolean }[] = [
  { label: "Tất cả" },
  { label: "Luyện tập" },
  { label: "Đề thi mới nhất", pro: true },
  { label: "Đề của HS", pro: true },
];

const PAGE_SIZE = 4;

/* ------------------------------------------------------------------ */
/*  HEATMAP (dữ liệu giả ổn định, TODO: thay bằng dữ liệu nộp bài thật) */
/* ------------------------------------------------------------------ */
const HEAT_MONTHS = [
  { label: "Tháng 07", weeks: 4 },
  { label: "Tháng 08", weeks: 5 },
  { label: "Tháng 09", weeks: 4 },
  { label: "Tháng 10", weeks: 4 },
];
const DAY_LABELS = ["T2", "", "T4", "", "T6", "", "CN"];
const HEAT_COLORS = [
  "bg-slate-200/70 dark:bg-slate-700/60",
  "bg-emerald-200",
  "bg-emerald-400",
  "bg-emerald-600",
];

function heatLevel(seed: number): number {
  const r = ((seed * 1103515245 + 12345) % 2147483648) / 2147483648;
  if (r > 0.96) return 3;
  if (r > 0.92) return 2;
  if (r > 0.86) return 1;
  return 0;
}

/* ------------------------------------------------------------------ */
/*  STYLE DÙNG CHUNG                                                    */
/* ------------------------------------------------------------------ */
const CARD =
  "rounded-[28px] border border-slate-200/70 bg-white/90 shadow-[0_2px_20px_-8px_rgba(15,23,42,0.12)] backdrop-blur dark:border-slate-800 dark:bg-slate-900/80";

function IconTile({ children, className = "" }: { children: React.ReactNode; className?: string }) {
  return (
    <div className={`grid size-12 shrink-0 place-items-center rounded-2xl ${className}`}>
      {children}
    </div>
  );
}

/* ------------------------------------------------------------------ */
/*  TRANG DASHBOARD                                                     */
/* ------------------------------------------------------------------ */
export default function DashboardPage() {
  const [statusTab, setStatusTab] = useState<(typeof STATUS_TABS)[number]>("Tất cả");
  const [typeTab, setTypeTab] = useState("Tất cả");
  const [skill, setSkill] = useState<Skill | "all">("all");
  const [query, setQuery] = useState("");
  const [page, setPage] = useState(1);

  const daysLeft = useMemo(() => {
    const now = new Date();
    const end = new Date(now.getFullYear(), 11, 31);
    return Math.max(0, Math.ceil((end.getTime() - now.getTime()) / 86400000));
  }, []);

  const filtered = useMemo(() => {
    const q = query.trim().toLowerCase();
    return EXAMS.filter((e) => {
      if (statusTab === "Chưa làm" && e.done) return false;
      if (statusTab === "Đã làm" && !e.done) return false;
      if (typeTab === "Luyện tập" && e.kind !== "practice") return false;
      if (typeTab === "Đề thi mới nhất" && e.kind !== "latest") return false;
      if (typeTab === "Đề của HS" && e.kind !== "student") return false;
      if (skill !== "all" && e.skill !== skill) return false;
      if (q && !e.title.toLowerCase().includes(q)) return false;
      return true;
    });
  }, [statusTab, typeTab, skill, query]);

  const totalPages = Math.max(1, Math.ceil(filtered.length / PAGE_SIZE));
  const currentPage = Math.min(page, totalPages);
  const pageItems = filtered.slice((currentPage - 1) * PAGE_SIZE, currentPage * PAGE_SIZE);

  const skillCount = (s: Skill) => EXAMS.filter((e) => e.skill === s).length;

  const resetPage = () => setPage(1);

  let heatSeed = 0;

  return (
    <div className="relative min-h-screen bg-[#fbfbfd] pb-20 dark:bg-slate-950">
      {/* nền chấm bi */}
      <div
        aria-hidden
        className="pointer-events-none absolute inset-0 opacity-70 dark:opacity-10"
        style={{
          backgroundImage: "radial-gradient(circle, #cbd5e1 1px, transparent 1px)",
          backgroundSize: "22px 22px",
        }}
      />

      <main className="relative mx-auto max-w-7xl space-y-6 px-4 pt-6 sm:px-6">
        {/* ============ HÀNG 1: LỘ TRÌNH | HÀNH TRÌNH | BXH ============ */}
        <div className="grid grid-cols-1 gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.55fr)_minmax(0,1.25fr)]">
          {/* LỘ TRÌNH */}
          <section className={`${CARD} p-6`}>
            <div className="flex items-center gap-3">
              <IconTile className="bg-sky-50 text-sky-500 dark:bg-sky-950/40">
                <MapIcon className="size-6" />
              </IconTile>
              <div>
                <div className="flex items-center gap-2">
                  <h2 className="text-lg font-extrabold text-slate-800 dark:text-slate-100">Lộ trình B1 & B2</h2>
                  <span className="rounded-md border border-sky-100 bg-sky-50 px-2 py-0.5 text-[11px] font-semibold text-sky-600">
                    Theo ngày
                  </span>
                </div>
                <p className="text-sm text-slate-500">Học theo ngày bài bản</p>
              </div>
            </div>

            <div className="mt-4 flex items-center gap-2 rounded-2xl border border-slate-200/70 bg-slate-50/80 px-3 py-2.5 text-sm text-slate-600 dark:border-slate-800 dark:bg-slate-800/50 dark:text-slate-300">
              <CalendarDays className="size-4 text-rose-400" />
              <span suppressHydrationWarning>
                Còn <b className="text-slate-900 dark:text-white">{daysLeft} ngày</b> (31/12)
              </span>
              <button className="ml-auto text-sm font-bold text-blue-600 hover:underline">Đổi</button>
            </div>

            <div className="mt-3 space-y-3">
              {ROADMAPS.map((r) => (
                <Link
                  key={r.name}
                  href={r.href}
                  className="group flex items-center gap-2 rounded-2xl border border-slate-200/70 bg-white px-4 py-3 transition hover:border-blue-200 hover:shadow-sm dark:border-slate-800 dark:bg-slate-900"
                >
                  <div className="min-w-0 flex-1">
                    <div className="flex items-center gap-2">
                      <span className={`size-2 rounded-full ${r.dot}`} />
                      <span className="truncate text-sm font-bold text-slate-800 dark:text-slate-100">{r.name}</span>
                      <span className={`ml-auto rounded-full border px-2 py-0.5 text-[11px] font-bold ${r.pill}`}>
                        {r.days} Ngày
                      </span>
                    </div>
                    <p className="mt-1 pl-4 text-xs text-slate-500">{r.sub}</p>
                  </div>
                  <ChevronRight className="size-4 text-slate-400 transition group-hover:translate-x-0.5" />
                </Link>
              ))}
            </div>
          </section>

          {/* HÀNH TRÌNH CHĂM CHỈ */}
          <section className={`${CARD} p-6`}>
            <div className="flex flex-wrap items-start justify-between gap-3">
              <div className="flex items-center gap-3">
                <IconTile className="bg-rose-50 text-rose-400 dark:bg-rose-950/40">
